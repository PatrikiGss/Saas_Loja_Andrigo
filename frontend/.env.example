# Endereço da API. Precisa constar em CORS_ORIGINS do backend.
VITE_API_URL=http://localhost:8000/api

# Tempo máximo de espera por resposta, em milissegundos.
VITE_TIMEOUT_MS=15000

# Formato do dinheiro na tela. O backend não guarda moeda: devolve o número.
# O padrão acompanha o resto do modelo, que é brasileiro, e precisa ser
# revisto quando o país de operação for definido.
VITE_LOCALE=pt-BR
VITE_MOEDA=BRL
