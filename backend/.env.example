SECRET_KEY=gere-uma-chave-nova
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite3
# DB_ENGINE=postgresql
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# Endereço do frontend, usado nos links enviados por e-mail
FRONTEND_URL=http://localhost:5173

# Origens que podem chamar a API (lista explícita, nunca liberar geral)
CORS_ORIGINS=http://localhost:5173

# Cookie httpOnly que carrega o refresh token.
# SAMESITE=Lax só funciona com front e API no mesmo site (porta não conta).
# Front em outro domínio exige None, e aí é preciso proteção de CSRF própria.
# REFRESH_COOKIE_NOME=refresh_token
# REFRESH_COOKIE_SAMESITE=Lax

# E-mail: em desenvolvimento sai no console. Para enviar de verdade, troque o
# backend e preencha as credenciais (nunca commite este arquivo preenchido).
# A entrega é feita pelo comando `manage.py enviar_emails`, que deve rodar de
# minuto em minuto no agendador do servidor.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USUARIO=
# EMAIL_SENHA=
# EMAIL_USA_TLS=True
# EMAIL_TIMEOUT=10
EMAIL_REMETENTE=nao-responda@localhost

# Cache compartilhado. Sem isto, o limite de tentativas conta por processo e
# não vale nada com vários workers.
# REDIS_URL=redis://localhost:6379/0

# Bloqueio de login por conta
# AXES_LIMITE_DE_FALHAS=5
# AXES_MINUTOS_BLOQUEADO=15

# Monitoramento de erro. Sem DSN, nada é iniciado e nada sai daqui.
# SENTRY_DSN=
# SENTRY_AMBIENTE=producao
# SENTRY_AMOSTRAGEM=0.0

# Logs
LOG_LEVEL=INFO

# HSTS em produção (um ano). Só vale com DEBUG desligado.
# HSTS_SEGUNDOS=31536000

# Consulta de CEP (ViaCEP)
# VIACEP_URL=https://viacep.com.br/ws/{cep}/json/
# CEP_TIMEOUT_SEGUNDOS=5
